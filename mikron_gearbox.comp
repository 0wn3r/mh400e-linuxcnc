component mikron_gearbox "Gear selection and VFD frequency for the Mikron WF41C gearbox";

description """
Selects the gearbox position for the requested spindle speed and the VFD frequency
that gives the exact speed inside that gear (stepless, 40 rpm .. 4800 rpm).

The gear table speeds are the synchronous speeds at *base-freq* (50 Hz). A requested
speed S runs in gear c at f = base-freq * S / c. The lowest gear with
c * max-freq / base-freq >= S is selected, so f stays between about 47 Hz and
*max-freq* (60 Hz). While the spindle stays on, the current gear is kept as long as
f stays between *hold-freq* and *max-freq* to avoid needless shifts.

Speeds between 0 and *min-rpm* are raised to *min-rpm*. When the spindle is off
(spindle-on FALSE) or S is 0 the gearbox is shifted to neutral.

*vfd-freq* is 0 while a gear change is running or has just been requested, and
*twitch-freq* while *twitch* is TRUE (gear-mesh twitch from the ladder).
*at-speed* is set when a model of the VFD ramp (*accel-rate*/*decel-rate*, Hz/s, matched to
the VFD acceleration/deceleration times) has reached *vfd-freq* while the VFD gets a run
command (*run-forward* or *run-reverse*).
""";

author "Sergey 'Jin' Bostandzhyan && Eduard Kachur";
license "GPL";

/* to be connected with spindle.0.speed-out-abs */
pin in float spindle_speed_in_abs = 0 "Desired spindle speed in rpm, always positive regardless of spindle direction";
pin out float spindle_speed_out_rps = 0 "Estimated spindle speed in revolutions per second (from the VFD ramp model)";
pin out float spindle_speed_out = 0 "Estimated spindle speed in rpm (from the VFD ramp model)";

pin out bit block_one_forward = 0 "Request forward position for block 1";
pin out bit block_one_middle = 0 "Request middle position for block 1";
pin out bit block_one_backward = 0 "Request backward position for block 1";
pin out bit block_two_forward = 0 "Request forward position for block 2";
pin out bit block_two_middle = 0 "Request middle position for block 2";
pin out bit block_two_backward = 0 "Request backward position for block 2";
pin out bit block_three_forward = 0 "Request forward position for block 3";
pin out bit block_three_middle = 0 "Request middle position for block 3";
pin out bit block_three_backward = 0 "Request backward position for block 3";
pin out bit motor_slow = 0 "Request first spindle motor speed range (delta)";
pin out bit motor_fast = 0 "Request second spindle motor speed range (YY)";

pin in bit changing = 0 "Gear change in progress (ladder)";
pin in bit spindle_on = 0 "spindle.0.on; FALSE shifts to neutral";
pin in bit machine_ready = 0 "Machine on";
pin in bit twitch = 0 "Gear-mesh twitch from the ladder, VFD runs at twitch-freq";
pin in bit run_forward = 0 "VFD run forward command (X1)";
pin in bit run_reverse = 0 "VFD run reverse command (X2)";

pin out float vfd_freq = 0 "VFD frequency command in Hz (to the analog output)";
pin out bit at_speed = 0 "VFD ramp model has reached vfd-freq";
pin out float freq_model = 0 "Modelled VFD output frequency, Hz";
pin out s32 gear = 0 "Requested gear table index, 0 = neutral";
pin out float gear_rpm = 0 "Synchronous speed of the requested gear at base-freq";

pin out bit estop_out = 0 "Gear change took longer than cycletime";
pin out float timeout_timer "Current value of elapsed gear change time";

param rw float cycletime = 77 "Gear change timeout, s";
param rw float min_rpm = 40 "Lowest spindle speed, lower requests are raised to it";
param rw float base_freq = 50 "Frequency the gear table speeds refer to, Hz";
param rw float max_freq = 60 "Highest VFD frequency, Hz";
param rw float hold_freq = 45 "Keep the current gear down to this frequency, Hz";
param rw float twitch_freq = 10 "VFD frequency during a gear-mesh twitch, Hz";
param rw float settle_time = 0.3 "Frequency stays 0 this long after a new gear request, s";
param rw float accel_rate = 20 "VFD acceleration, Hz/s (max-freq / acceleration time)";
param rw float decel_rate = 20 "VFD deceleration, Hz/s (max-freq / deceleration time)";
param rw float at_speed_tol = 0.5 "at-speed tolerance, Hz";

variable double ctimer = 0;
variable double settle = 0;
variable int cur = -1;
variable double est_gear = 0;

function _;

option singleton yes;

;;

#include <rtapi_math.h>

#include "mikron_common.h"
#include "mikron_util.h"
#include "mikron_gears.h"

static bool g_setup_done = false;

FUNCTION(_)
{
    double s, target, out;
    int want;

    if (!g_setup_done)
    {
        gearbox_setup(__comp_inst, period);
        set_gear_request(&zero_gear);
        g_setup_done = true;
    }

    if (!machine_ready)
    {
        /* drop all requests; cur = -1 makes the next request go out again */
        set_gear_request(&zero_gear);
        cur = -1;
        gear = 0;
        gear_rpm = 0;
        estop_out = 0;
        ctimer = 0;
        settle = 0;
        vfd_freq = 0;
        at_speed = 0;
        freq_model = 0;
        est_gear = 0;
        spindle_speed_out = 0;
        spindle_speed_out_rps = 0;
        return;
    }

    /* requested speed, limited to what the gearbox and VFD can do */
    s = spindle_speed_in_abs;
    if (spindle_on && s > 0)
    {
        double smax = mikron_gears[MIKRON_MAX_GEAR_INDEX].key * max_freq / base_freq;
        if (s < min_rpm) s = min_rpm;
        if (s > smax) s = smax;
        want = select_gear_stepless(s, cur, base_freq, max_freq, hold_freq);
    }
    else
    {
        s = 0;
        want = MIKRON_NEUTRAL_GEAR_INDEX;
    }

    if (!changing)
    {
        ctimer = 0;
        timeout_timer = 0;
        if (want != cur)
        {
            /* new requests only between gear changes */
            set_gear_request(&mikron_gears[want]);
            cur = want;
            settle = 0;
        }
        else if (settle < settle_time)
        {
            settle += fperiod;
        }
    }
    else
    {
        settle = 0;
        ctimer += fperiod;
        timeout_timer = ctimer;
        if (ctimer > cycletime)
        {
            estop_out = 1;
        }
    }

    gear = cur;
    gear_rpm = (cur > 0) ? mikron_gears[cur].key : 0;

    /* frequency for the requested speed in the requested gear */
    target = 0;
    if (cur > 0 && cur == want && s > 0)
    {
        target = base_freq * s / gear_rpm;
    }

    if (twitch)
        out = twitch_freq;
    else if (changing || settle < settle_time)
        out = 0;
    else
        out = target;
    if (out > max_freq) out = max_freq;
    if (out < 0) out = 0;
    vfd_freq = out;

    /* model of the VFD ramp */
    {
        int running = run_forward || run_reverse;
        double goal = running ? out : 0;
        double f = freq_model;
        if (f < goal)
        {
            f += accel_rate * fperiod;
            if (f > goal) f = goal;
        }
        else if (f > goal)
        {
            f -= decel_rate * fperiod;
            if (f < goal) f = goal;
        }
        freq_model = f;

        at_speed = running && target > 0 && !changing && !twitch
                   && fabs(freq_model - out) <= at_speed_tol;
    }

    /* keep the last gear for the estimate while the spindle coasts down
     * after a neutral request */
    if (gear_rpm > 0 || freq_model <= 0) est_gear = gear_rpm;
    spindle_speed_out = est_gear * freq_model / base_freq;
    spindle_speed_out_rps = spindle_speed_out / 60.0;
}
